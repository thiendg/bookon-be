							"mode": "raw",
							"raw": "{\n    \"email\": \"{{userEmail}}\",\n    \"password\": \"{{userPassword}}\",\n    \"full_name\": \"Test User\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/modules/auth/api/register.php",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"modules",
								"auth",
								"api",
								"register.php"
							]
						}
					},
					"response": [
						{
							"name": "Register Success",
							"originalRequest": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"password123\",\n    \"full_name\": \"Test User\"\n}"
								},
								"url": {
									"raw": "{{baseUrl}}/modules/auth/api/register.php",
									"host": [
										"{{baseUrl}}"
									],
									"path": [
										"modules",
										"auth",
										"api",
										"register.php"
									]
								}
							},
							"status": "Created",
							"code": 201,
							"_postman_previewlanguage": "json",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"cookie": [],
							"body": "{\n    \"success\": true,\n    \"message\": \"Registration successful. Please check your email to verify your account.\",\n    \"data\": {\n        \"user\": {\n            \"id\": \"1\",\n            \"email\": \"test@example.com\",\n            \"full_name\": \"Test User\",\n            \"status\": \"unverified\",\n            \"avatar_url\": \"default_avatar.png\",\n            \"role_id\": null,\n            \"phone_number\": null,\n            \"address\": null,\n            \"created_at\": \"1678886400\",\n            \"updated_at\": \"1678886400\"\n        },\n        \"verification_token\": \"some_verification_token\"\n    }\n}"
						}
					],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data.verification_token) {",
									"    pm.collectionVariables.set(\"verificationToken\", jsonData.data.verification_token);",
									"    console.log(\"Verification Token: \" + pm.collectionVariables.get(\"verificationToken\"));",
								"}"
							],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Verify Email",
